# ── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=wowchat
POSTGRES_USER=wowchat
POSTGRES_PASSWORD=wowchat_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── MongoDB ───────────────────────────────────────────────
MONGO_USER=wowchat
MONGO_PASSWORD=wowchat_secret
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=wowchat_messages

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=wowchat_redis
REDIS_HOST=redis
REDIS_PORT=6379

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:wowchat_redis@redis:6379/0
CELERY_RESULT_BACKEND=django-db

# ── WhatsApp Cloud API ────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Groq / LLM ───────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── App ───────────────────────────────────────────────────
SITE_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
